{
    "name": "nathantutors",
    "private": true,
    "version": "0.0.0",
    "engines": {
        "node": ">=22.12.0"
    },
    "workspaces": [
        "client",
        "server"
    ],
    "scripts": {
        "dev": "concurrently \"npm run dev --workspace client\" \"npm run dev --workspace server\"",
        "dev:client": "npm run dev --workspace client",
        "dev:server": "npm run dev --workspace server",
        "build": "npm run build --workspace client && npm run build --workspace server",
        "build:client": "npm run build --workspace client",
        "build:server": "npm run build --workspace server",
        "typecheck": "npm run typecheck --workspace client && npm run typecheck --workspace server",
        "typecheck:client": "npm run typecheck --workspace client",
        "typecheck:server": "npm run typecheck --workspace server",
        "start": "npm run start --workspace server",
        "seed:students": "npm run seed:students --workspace server",
        "migrate:staff-dashboard": "node server/scripts/migrate-staff-dashboard-data.mjs",
        "migrate:staff-dashboard:compact": "node server/scripts/migrate-staff-dashboard-data.mjs --compact",
        "lint": "npm run lint --workspace client",
        "lint:client": "npm run lint --workspace client",
        "verify": "npm run typecheck && npm run lint && npm run build",
        "preview": "npm run preview --workspace client",
        "question-editor": "node tools/question-bank-editor.mjs",
        "question-editor:validate": "node tools/question-bank-editor.mjs --validate"
    },
    "devDependencies": {
        "concurrently": "^9.1.2"
    }
}
