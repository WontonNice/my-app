{
    "name": "nathantutors",
    "private": true,
    "version": "0.0.0",
    "engines": {
        "node": ">=22.12.0"
    },
    "workspaces": [
        "client",
        "server"
    ],
    "scripts": {
        "dev": "concurrently --kill-others-on-fail \"node tools/wait-for-api.cjs && npm run dev --workspace client\" \"npm run dev --workspace server\"",
        "dev:client": "npm run dev --workspace client",
        "dev:server": "npm run dev --workspace server",
        "test:dev-startup": "node --test tools/dev-startup.test.cjs",
        "build": "npm run build --workspace client && npm run build --workspace server",
        "build:client": "npm run build --workspace client",
        "build:server": "npm run build --workspace server",
        "typecheck": "npm run typecheck --workspace client && npm run typecheck --workspace server",
        "typecheck:client": "npm run typecheck --workspace client",
        "typecheck:server": "npm run typecheck --workspace server",
        "start": "npm run start --workspace server",
        "seed:students": "npm run seed:students --workspace server",
        "migrate:staff-dashboard": "node server/scripts/migrate-staff-dashboard-data.mjs",
        "migrate:staff-dashboard:compact": "node server/scripts/migrate-staff-dashboard-data.mjs --compact",
        "lint": "npm run lint --workspace client",
        "lint:client": "npm run lint --workspace client",
        "verify": "npm run typecheck && npm run lint && npm run build",
        "preview": "npm run preview --workspace client",
        "content-editor": "node tools/content-studio.mjs",
        "content-editor:validate": "node tools/content-studio.mjs --validate",
        "content-editor:test": "node --test tools/content-studio-workspace.test.mjs tools/content-studio-math.test.mjs tools/content-studio-exams.test.mjs tools/exam-duplicates.test.mjs tools/part-b-bank.test.cjs tools/passage-category-editor.test.mjs tools/math-topic-editor.test.mjs tools/sentence-blanks.test.cjs",
        "test:passage-organization": "node --test server/tests/passage-organization.test.cjs",
        "test:answer-sheets": "node --test server/tests/answer-sheets.test.cjs server/tests/answer-sheet-sync.test.cjs",
        "preview:answer-sheets": "node tools/preview-answer-sheets.cjs",
        "preview:assessments": "node tools/preview-teacher-assessments.cjs",
        "preview:games": "node tools/preview-game-rooms.cjs",
        "test:accounts": "node --test server/tests/account-profile.test.cjs server/tests/account-mail.test.cjs server/tests/account-preferences.test.cjs",
        "test:classroom": "node --test server/tests/exam-reentry.test.cjs server/tests/exam-section-progress.test.cjs server/tests/game-rooms.test.cjs server/tests/team-race.test.cjs server/tests/game-world.test.cjs server/tests/game-world-upgrades.test.cjs tools/world-avatar.test.cjs tools/crystal-scene.test.cjs tools/crystal-panel.test.cjs server/tests/crystal-defense.test.cjs server/tests/crystal-sources.test.cjs server/tests/achievements.test.cjs",
        "test:study-hall": "node --test server/tests/library-books.test.cjs server/tests/question-bank-routes.test.cjs tools/study-hall-view.test.cjs",
        "preview:study-hall": "node tools/preview-study-hall.cjs",
        "test:exam-review": "node --test server/tests/exam-review.test.cjs",
        "test:student-analytics": "node --test server/tests/student-analytics.test.cjs server/tests/analytics-workspace.test.cjs server/tests/exam-section-progress.test.cjs",
        "test:corrections": "node --test server/tests/exam-review.test.cjs server/tests/teacher-workflows.test.cjs server/tests/question-bank-routes.test.cjs server/tests/correction-navigation.test.cjs tools/corrections-view.test.cjs",
        "test:boards": "node --test server/tests/boards.test.cjs",
        "preview:boards": "node tools/preview-boards.cjs",
        "test:learning-plan": "node --test server/tests/learning-plan.test.cjs",
        "test:math-command": "node --test server/tests/math-command-catalog.test.cjs server/tests/math-command-management.test.cjs server/tests/math-command-persistence.test.cjs server/tests/math-command.test.cjs tools/export-exam-content.test.cjs",
        "preview:math-command": "node tools/preview-math-command.cjs --port=4328",
        "seed:math-command": "node tools/seed-math-command.cjs",
        "test:question-bank": "node --test tools/question-bank.test.mjs tools/content-studio-bank.test.cjs extensions/shsatlab-ela-reader/reader.test.cjs extensions/shsatlab-ela-reader/automation.test.cjs extensions/shsatlab-ela-reader/popup.test.cjs extensions/shsatlab-ela-reader/bulk.test.cjs extensions/shsatlab-ela-reader/editor-sync.test.cjs server/tests/question-bank-routes.test.cjs",
        "test:import-readers": "node --test extensions/sat-crash-course-reader/reader.test.cjs extensions/sat-crash-course-reader/rich-text.test.cjs extensions/sat-crash-course-reader/tei.test.cjs extensions/shsatlab-ela-reader/reader.test.cjs extensions/shsatlab-ela-reader/automation.test.cjs extensions/shsatlab-ela-reader/popup.test.cjs extensions/shsatlab-ela-reader/bulk.test.cjs extensions/shsatlab-ela-reader/editor-sync.test.cjs",
        "test:exam-presentation": "node --test server/tests/exam-presentation.test.cjs server/tests/math-entry-input.test.cjs server/tests/advanced-math-entry.test.cjs tools/exam-session-view.test.cjs",
        "test:shsat-countdown": "node --test server/tests/shsat-countdown.test.cjs",
        "exam-editor": "npm run content-editor",
        "exam-editor:validate": "npm run content-editor:validate",
        "question-editor": "npm run content-editor",
        "question-editor:validate": "npm run content-editor:validate",
        "test:document-import": "node tools/generate-document-prompt.mjs --check && node --test tools/document-import.test.mjs tools/document-render.test.cjs tools/math-import-batch.test.mjs",
        "content-editor:prompt": "node tools/generate-document-prompt.mjs",
        "test:passage-progress": "node --test server/tests/passage-organization.test.cjs server/tests/learning-plan.test.cjs tools/passage-progress-view.test.cjs",
        "test:practice-studio": "node --test server/tests/practice-catalog.test.cjs tools/topic-practice-defaults.test.cjs tools/inequality-practice.test.cjs tools/writing-inequalities.test.cjs tools/overlapping-groups.test.cjs tools/word-problem-practice.test.cjs tools/practice-player.test.cjs tools/math-study-hall.test.cjs tools/study-hall-view.test.cjs"
    },
    "devDependencies": {
        "concurrently": "^9.1.2",
        "mathlive": "0.110.0"
    }
}
