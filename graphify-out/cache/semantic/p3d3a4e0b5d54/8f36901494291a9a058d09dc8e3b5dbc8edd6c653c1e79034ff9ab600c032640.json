{"nodes": [{"id": "design", "label": "Design System: Nathan Tutors Learning Room and classroom meals", "file_type": "document", "source_file": "DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_the_learning_room", "label": "The Learning Room (Creative North Star)", "file_type": "rationale", "rationale": "Name comes from the existing student navigation, not a new brand workshop; it records the built visual vocabulary and does not establish a global design system for all Nathan Tutors products.", "source_file": "DESIGN.md", "source_location": "Overview", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_shell_boundary_rule", "label": "The Shell Boundary Rule", "file_type": "rationale", "rationale": "Use a surface's existing shell and scoped palette; the record does not recolor teacher navigation or authentication.", "source_file": "DESIGN.md", "source_location": "Colors", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_heading_role_rule", "label": "The Heading Role Rule", "file_type": "rationale", "rationale": "Serif headings stay scoped to overview and teacher surfaces; bold sans-serif hierarchy is for the photo-led storefront. Neither is a product-wide display-font mandate.", "source_file": "DESIGN.md", "source_location": "Typography", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_classroom_storefront", "label": "Classroom Meal Storefront", "file_type": "concept", "rationale": "Follows the user's restaurant-card and featured-item references: photo-led browsing, bold sans-serif headings, compact ratings, red display-only offer labels; a scoped change, not a new portal identity.", "source_file": "DESIGN.md", "source_location": "Overview", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_wonton", "label": "Wonton Sprite Companion", "file_type": "concept", "rationale": "Transparent full-body eight-frame sprite derived from the original black-and-white box-robot reference, replacing the cropped-image treatment; pause control and reduced-motion rules disable animation; docks in normal flow at 700px so it does not cover study links.", "source_file": "DESIGN.md", "source_location": "Wonton and authentication scenery", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_shared_meal_controls", "label": "Shared Meal Controls (buttons, fields, summary)", "file_type": "concept", "source_file": "DESIGN.md", "source_location": "Components", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_student_shell", "label": "Student Portal Shell (sidebar, topbar, overview layout)", "file_type": "concept", "source_file": "DESIGN.md", "source_location": "Layout", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_teacher_meal_page", "label": "Teacher Meal Page (CorporateDashboardShell)", "file_type": "concept", "rationale": "Keeps the incumbent navy dashboard shell and cooler canvas; it is not migrated to the student shell.", "source_file": "DESIGN.md", "source_location": "Overview", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_authentication_scenery", "label": "Authentication Scenery (Instrument Serif / DM Sans, ripple and meadow scenes)", "file_type": "concept", "rationale": "Authentication keeps its separate font pairing and scene composition; these are not portal type tokens, and preserved assets must not be replaced.", "source_file": "DESIGN.md", "source_location": "Wonton and authentication scenery", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_meal_request_status_panel", "label": "Student Meal Request Status Panel", "file_type": "concept", "rationale": "Each status