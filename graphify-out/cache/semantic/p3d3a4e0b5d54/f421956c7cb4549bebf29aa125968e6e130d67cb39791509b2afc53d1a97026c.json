{"nodes": [{"id": "docs_adr_0001_learning_activity_organization", "label": "ADR 0001: Separate learning activities over shared question banks", "file_type": "document", "source_file": "docs/adr/0001-learning-activity-organization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_0001_learning_activity_organization_five_question_banks", "label": "Five question banks decision", "file_type": "rationale", "rationale": "Teachers need to reuse canonical questions while distinguishing focused practice, mixed review, and exams; a bank is different from a publisher, and SHSAT Lab keeps its bank identity while using the ELA area's categories.", "source_file": "docs/adr/0001-learning-activity-organization.md", "source_location": "Decisions 1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_0001_learning_activity_organization_learning_taxonomy", "label": "learning-taxonomy.json stable category/topic IDs and question-organization.json overrides", "file_type": "concept", "rationale": "Area-scoped stable IDs with rename aliases; an authored-classification fingerprint lets later native source edits supersede stale overrides; missing classifications remain visible review work.", "source_file": "docs/adr/0001-learning-activity-organization.md", "source_location": "Decisions 2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_0001_learning_activity_organization_activitystore", "label": "activityStore (worksheets.json / assessments.json journaled persistence)", "file_type": "concept", "rationale": "Separate persistence for worksheets and assessments with a compatible combined read and optimistic revision checks; existing routes remain compatibility adapters so the shared player, access controls, assignments, and grader are not duplicated.", "source_file": "docs/adr/0001-learning-activity-organization.md", "source_location": "Decisions 3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_0001_learning_activity_organization_publication_review", "label": "Publication review of preview hash and validation", "file_type": "rationale", "rationale": "Per the user's November 13, 2026 decision, exam publication allows missing category, source, and math topic metadata so reviewed exams reach students before classification is complete; worksheet publication still validates scope, provenance, and classification.", "source_file": "docs/adr/0001-learning-activity-organization.md", "source_location": "Decisions 4", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_0001_learning_activity_organization_activity_releases", "label": "Immutable activity releases (activity-releases.json)", "file_type": "concept", "rationale": "Released content is immutable; subsequent draft edits do not change the release.", "source_file": "docs/adr/0001-learning-activity-organization.md", "source_location": "Decisions 4", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_0001_learning_activity_organization_release_pinned_attempts", "label": "Release-pinned attempts (activityReleaseId)", "file_type": "concept", "rationale": "Active assembly attempts are pinned to their release so the server grades from the trusted edition and completed results keep original analysis snapshots.", "source_file": "docs/adr/0001-learning-activity-organization.md", "source_location": "Decisions 6", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_0001_learning_activity_organization_generated_response_archive", "label": "Generated response archive (math_practice_checkpoints reserved key)", "file_type": "concept", "rationale": "Each generated response is archived immutably with exact question, seed, and generator version; grading is recomputed on the server and conflicting repeated answers are rejected.", "source_file": "docs/adr/0001-learning-activity-organization.md", "source_location": "Decisions 7", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_0001_learning_activity_organization_generation_signature_approval", "label": "Generation signature approval before generator publication", "file_type": "concept", "rationale": "New or materially changed generators require approval of the matching generation signature; publication intent never asserts catalog availability or bypasses that approval.", "source_file": "docs/adr/0001-learning-activity-organization.md", "source_location": "Decisions 8", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_0001_learning_activity_organization_acceptance_testing", "label": "UI-only acceptance testing protocol", "file_type": "rationale", "rationale": "Acceptance tasks use only the implemented UI; no code, content, permission, or configuration edits to make a task pass; gaps are recorded and fixed only after testing.", "source_file": "docs/adr/0001-learning-activity-organization.md", "source_location": "Acceptance testing", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_adr_0001_learning_activity_organization", "target": "docs_adr_0001_learning_activity_organization_five_question_banks", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0001-learning-activity-organization.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0001_learning_activity_organization", "target": "docs_adr_0001_learning_activity_organization_learning_taxonomy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0001-learning-activity-organization.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0001_learning_activity_organiza