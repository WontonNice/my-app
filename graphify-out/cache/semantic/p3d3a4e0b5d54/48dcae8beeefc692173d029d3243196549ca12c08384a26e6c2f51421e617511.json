{"nodes": [{"id": "agents_skills_impeccable_reference_adapt", "label": "Adapt Command Reference (web)", "file_type": "document", "source_file": ".agents/skills/impeccable/reference/adapt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_impeccable_reference_adapt_adaptation_is_rethinking_not_scaling", "label": "Adaptation Is Rethinking, Not Scaling", "file_type": "rationale", "source_file": ".agents/skills/impeccable/reference/adapt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The trap is treating adaptation as scaling pixels; the job is rethinking the experience for the new context."}, {"id": "agents_skills_impeccable_reference_adapt_mobile_adaptation", "label": "Mobile Adaptation Strategy (Desktop to Mobile)", "file_type": "concept", "source_file": ".agents/skills/impeccable/reference/adapt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_impeccable_reference_adapt_content_driven_breakpoints", "label": "Content-Driven Breakpoints / Mobile-First", "file_type": "rationale", "source_file": ".agents/skills/impeccable/reference/adapt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Don't chase device sizes; break where the design breaks. Mobile-first min-width queries avoid loading unnecessary styles on mobile."}, {"id": "agents_skills_impeccable_reference_adapt_touch_targets_44px", "label": "Touch Targets 44x44px Minimum (web)", "file_type": "concept", "source_file": ".agents/skills/impeccable/reference/adapt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_impeccable_reference_adapt_input_method_detection", "label": "Detect Input Method via pointer/hover Queries", "file_type": "rationale", "source_file": ".agents/skills/impeccable/reference/adapt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Screen size doesn't tell you input method; touch users can't hover, so functionality must not rely on hover."}, {"id": "agents_skills_impeccable_reference_adapt_safe_areas", "label": "Safe Areas via env() Insets", "file_type": "concept", "source_file": ".agents/skills/impeccable/reference/adapt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_impeccable_reference_adapt_custom_controls_verification", "label": "Custom Controls Gesture Verification", "file_type": "rationale", "source_file": ".agents/skills/impeccable/reference/adapt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Screenshots and resized viewports verify layout, never a gesture; say what produced the evidence and name what stayed untested."}, {"id": "agents_skills_impeccable_reference_adapt_real_device_testing", "label": "Test on Real Devices, Not DevTools Alone", "file_type": "rationale", "source_file": ".agents/skills/impeccable/reference/adapt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DevTools emulation misses real touch, CPU/memory constraints, network latency, font rendering and browser chrome."}], "edges": [{"source": "agents_skills_impeccable_reference_adapt", "target": "agents_skills_impeccable_reference_adapt_adaptation_is_rethinking_not_scaling", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/impeccable/reference/adapt.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_impeccable_reference_adapt", "target": "agents_skills_impeccable_reference_adapt_mobile_adaptation", "relation": "references",