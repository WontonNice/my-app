{
  "manifest_version": 3,
  "name": "Nathan Tutors — SHSATLab ELA Capture",
  "version": "1.3.0",
  "description": "English capture with opt-in AFK runs, durable saved questions, and local Content Editor draft imports.",
  "permissions": ["activeTab", "storage"],
  "action": { "default_popup": "popup.html" },
  "content_scripts": [{
    "matches": ["https://www.shsatlab.com/units/unit-*/practice*", "https://shsatlab.com/units/unit-*/practice*"],
    "js": ["reader.js", "queue.js", "automation.js", "bulk.js", "content.js"],
    "run_at": "document_idle"
  }, {
    "matches": ["http://127.0.0.1:4319/*", "http://localhost:4319/*"],
    "js": ["editor-sync.js"],
    "run_at": "document_idle"
  }]
}
